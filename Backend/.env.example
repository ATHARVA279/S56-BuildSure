# MongoDB. Use a local server or Atlas. Do not commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=construct_code_db

# auto uses MongoDB when the URI answers a ping, otherwise a local JSON store.
# Tests force memory. Use local to run without a database server.
# BUILDSURE_STORAGE=auto
# BUILDSURE_STORAGE=local
# BUILDSURE_STORAGE=mongo

# Groq. Leave blank to quote retrieved text instead of calling a model.
# Put the real key only in Backend/.env, never in this file.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Optional.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MAX_UPLOAD_BYTES=26214400
